# Credentials template for the LSB data pipeline.
#
# Copy to .env and fill in real values. .env is gitignored and must never
# be committed.
#
#   cp .env.example .env
#   $EDITOR .env
#   set -a && source .env && set +a
#
# Then run any downloader normally:
#   python download_arm.py --datastream twpmetC1.b1 --start_date 2011-10-01 ...

# ARM Data Center -- https://adc.arm.gov/armlive/
# Used by: download_arm.py
ARM_USERNAME=
ARM_TOKEN=

# Copernicus Climate Data Store -- https://cds.climate.copernicus.eu/
# Used by: get_dataset.py (via cdsapi)
# cdsapi normally reads ~/.cdsapirc; these are for containerized runs.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# NASA Earthdata -- https://urs.earthdata.nasa.gov/
# Used by: download_imerg.py (via earthaccess)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
